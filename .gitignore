# Build outputs
build/
build-*/
out/

# The "ready to copy into <game>/d2rloader" folder that CMakeLists.txt
# regenerates on every build (see the RSS_DEPLOY_* custom command). Not
# committed -- CI rebuilds and zips it fresh for each Release.
deploy/

# Local, machine-specific CMake presets (e.g. a D2RLOADER_GAME_DIR path).
# Keep CMakePresets.json (shared/committed) separate from this.
CMakeUserPresets.json

# Visual Studio / VS Code local state
.vs/
*.user
